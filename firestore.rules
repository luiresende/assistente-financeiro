rules_version = '2';

// ============================================================================
// Firestore Security Rules — assistente financeiro
// ----------------------------------------------------------------------------
// Modelo de dados (tudo sob o uid do dono):
//   users/{uid}/entries/{entryId}   -> lançamentos (receitas/despesas)
//   users/{uid}/meta/settings       -> categorias + orçamentos
//
// CONTROLE DE ACESSO (duas condições, ambas obrigatórias):
//   1) o e-mail autenticado precisa estar na ALLOWLIST (função allowed()); e
//   2) o usuário só acessa os dados sob o PRÓPRIO uid.
//
// Assim, mesmo quem conseguir criar um login no Firebase Auth NÃO lê nem
// escreve nada se o e-mail não estiver liberado aqui.
//
// >>> MANTENHA allowed() EM SINCRONIA com ALLOWED_EMAILS em js/store.js. <<<
// Para liberar alguém: adicione o e-mail (minúsculo) nos DOIS lugares e
// republique estas regras no console do Firebase.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Lista de e-mails autorizados (minúsculo). Espelha ALLOWED_EMAILS no app.
    function allowed() {
      return [
        'lcresendealm@gmail.com'
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // E-mail autenticado, normalizado em minúsculo.
    function userEmail() {
      return isSignedIn() ? request.auth.token.email.lower() : '';
    }

    // Autorizado = logado E com e-mail na allowlist.
    function isAllowed() {
      return isSignedIn() && (userEmail() in allowed());
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Tudo sob users/{uid}/... pertence a esse usuário E exige allowlist.
    match /users/{uid}/{document=**} {
      allow read, write: if isAllowed() && isOwner(uid);
    }
  }
}
